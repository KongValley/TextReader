{
  "name": "txt-novel-reader",
  "version": "1.3.0",
  "description": "轻量 TXT 小说阅读器（Electron）",
  "author": "txt-reader",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "electron:install": "node node_modules/electron/install.js",
    "test": "node --test",
    "smoke": "node scripts/run-smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "pdfjs-dist": "6.3.289"
  }
}
